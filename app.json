{
  "configVersion": "v3",
  "app": {
    "appId": 1130272,
    "appName": "T9 Russian Keyboard",
    "appType": "app",
    "version": {
      "code": 3,
      "name": "1.1.1"
    },
    "icon": "icon.png",
    "vender": "chebishev",
    "description": "T9 English/Russian keyboard"
  },
  "permissions": [
    "device:os.input.method",
    "data:os.device.info",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.2"
    }
  },
  "targets": {
    "default": {
      "module": {
        "page": {
          "pages": [
            "page/index",
            "page/instructions",
            "page/about",
            "data-widget/index"
          ]
        },
        "data-widget": {
          "widgets": [
            {
              "name": "T9 Russian Keyboard",
              "path": "data-widget/index",
              "icon": "icon.png",
              "runtime": {
                "ability": [
                  {
                    "name": "ru-RU",
                    "type": 2,
                    "subType": []
                  }
                ]
              }
            }
          ]
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        },
        {
          "st": "s",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "T9 Russian Keyboard"
    },
    "ru-RU": {
      "appName": "T9 Русская Клавиатура"
    }
  },
  "defaultLanguage": "en-US"
}